Require all granted

<IfModule mod_autoindex.c>
	Options -Indexes
</IfModule>

# index.php exists only when the deploy added it; a plain build serves
# index.html. "/" is a directory, so the front controller below never sees it - DirectoryIndex does.
DirectoryIndex index.php index.html

# Where index.php asks for the metadata (GET /v1/meta).
<IfModule mod_env.c>
	SetEnv SFTOOLS_API_URL https://api.new.satisfactorytools.com
</IfModule>

# The beta host is marked noindex so it does not compete with the real site; moot after the move.
<IfModule mod_setenvif.c>
	SetEnvIf Host ^new\. SFTOOLS_BETA_HOST
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On

	RewriteRule /\.|^\.(?!well-known/) - [F]

	# front controller: index.php when deployed (link previews), else index.html
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{DOCUMENT_ROOT}/index.php -f
	RewriteRule !\.(pdf|js|mjs|ico|gif|jpg|jpeg|png|webp|svg|css|rar|zip|7z|tar\.gz|map|eot|ttf|otf|woff|woff2)$ index.php [L]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule !\.(pdf|js|mjs|ico|gif|jpg|jpeg|png|webp|svg|css|rar|zip|7z|tar\.gz|map|eot|ttf|otf|woff|woff2)$ index.html [L]
</IfModule>

# index.html must always be revalidated, otherwise a cached copy keeps pointing at hashed bundles a
# later deploy has replaced (blank page). The hashed bundles never change.
<IfModule mod_headers.c>
	Header set X-Robots-Tag "noindex, nofollow" env=SFTOOLS_BETA_HOST

	# blob: + wasm-unsafe-eval: the solver runs HiGHS (WebAssembly) in a worker built from a blob.
	# Images may come from any https host: provider avatars (Discord, GitHub, Google, Steam).
	Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://analytics.greeny.dev; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.new.satisfactorytools.com https://analytics.greeny.dev blob: data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"

	<FilesMatch "^(index\.html|boot-fallback\.js)$">
		Header set Cache-Control "no-cache, no-store, must-revalidate"
		Header set Pragma "no-cache"
		Header set Expires "0"
	</FilesMatch>
	<FilesMatch "-[0-9A-Z]{8}\.(js|mjs|css)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
	<IfModule mod_filter.c>
		AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
	</IfModule>
</IfModule>
